<!--index.wxml-->
<view class="flex-wrp" style="flex-direction:row;">
  <view class="form">
    <view class="row" bindtap="showPicker">
      <view>学院： </view>
      <view class="picker">{{selectValue.school.label}},{{selectValue.academe.label}},{{selectValue.grade.label}}</view>
    </view>
    <view class="section row">
      <picker bindchange="pickerClassChange" value="{{classId}}" range="{{classList}}">
        <view class="picker">
          班级：{{classList[classId]}}
        </view>
      </picker>
    </view>
    <view class="button-row">
      <view wx:if="{{error}}">{{error}}</view>
      <button wx:if="{{error}}" bindtap="getClassName" disabled="{{loading}}">重新加载班级</button>
      <button type="primary" bindtap="search" loading="{{loading}}" disabled="{{loading || !classList.length}}">查询</button>
      <button style="margin-top: 20rpx" open-type="contact">联系客服</button>
    </view>
  </view>
</view>

<view class="picker-section" wx:if="{{isShowPicker}}">
  <view class="picker_title">
    <button bindtap="pickerSelected">确定</button>
  </view>
  <picker-view indicator-style="height: 50px;" style="width: 100%; height: 300px;" value="{{pickerValue}}" bindchange="selectChange">
    <picker-view-column>
      <view wx:for="{{schools}}" wx:key="value" style="line-height: 50px">{{item.label}}</view>
    </picker-view-column>
    <picker-view-column>
      <view wx:for="{{academe}}" wx:key="value" style="line-height: 50px">{{item.label}}</view>
    </picker-view-column>
    <picker-view-column>
      <view wx:for="{{grade}}" wx:key="value" style="line-height: 50px">{{item.label}}</view>
    </picker-view-column>
  </picker-view>
</view>